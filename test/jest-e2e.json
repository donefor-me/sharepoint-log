{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "globalSetup": "<rootDir>/global-setup.ts",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testTimeout": 60000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@core(.*)$": "<rootDir>/../src/core$1",
    "^@common(.*)$": "<rootDir>/../src/common$1",
    "^@modules(.*)$": "<rootDir>/../src/modules$1"
  }
}
